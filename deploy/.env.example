# انسخ هذا الملف باسم .env وغيّر القيم. لا ترفع .env على GitHub أبداً.
DEBUG=false
SECRET_KEY=ضع-هنا-نص-عشوائي-طويل
POSTGRES_PASSWORD=ضع-هنا-كلمة-سر-قوية
# بدون دومين خليها * ، وويا دومين: chat.asbat.edu.iq
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
# ويا دومين حقيقي: SITE_ADDRESS=chat.asbat.edu.iq (وCaddy يطلع HTTPS تلقائياً)
SITE_ADDRESS=:80
# عدد العمال (افتراضياً: 2 × عدد المعالجات). WEB = الـ API، WS = الاتصالات المباشرة
# WEB_WORKERS=8
# WEB_THREADS=16
# WS_WORKERS=8
# مفتاح تشفير الرسائل: إذا ما حطيته، ينولد تلقائياً وينحفظ بـ volume اسمه keys (لازم تاخذله نسخة احتياطية!)
# MESSAGE_KEY=
# عنوان للتواصل يُرسل لخدمات الإشعارات (Google/Apple). يجب أن يكون بريداً حقيقياً أو رابط الموقع،
# فخدمة Apple ترفض العناوين الوهمية ولا يصل أي إشعار إلى الآيفون. مثال:
# VAPID_CONTACT=mailto:it-support@your-college.edu.iq
# خادم ترحيل TURN للمكالمات بين شبكتين مختلفتين (يكفي واحد من الثلاثة، انظر docs/DEPLOY.md):
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# TURN_CREDENTIALS_URL=
# TURN_URLS=turn:turn.your-college.edu.iq:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
